# Python environment (rebuild with: python -m venv venv + pip install)
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Downloaded and generated data (can be re-downloaded / regenerated)
raw/
clean/
*.log

# Visual Studio / SSIS / SSAS build output and user files
ssis/**/bin/
ssis/**/obj/
ssis/**/.vs/
ssas/**/bin/
ssas/**/obj/
.vs/
*.user
*.suo
*.database

# Power BI project: keep the definition, not the local cache / settings
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf
powerbi/*.damaged/
*.abf


# YouTube video kit (large media, generated by video_kit/_source)
video_kit/
video_kit.zip

# Local tool settings, secrets, OS and Office junk
.claude/
.vscode/
.env
.env.*
*.pem
*.key
credentials*.json
~$*
*.tmp
*.bak
Thumbs.db
desktop.ini
.DS_Store

# Personal working notes (kept locally, not published)
docs/PLAN.md
docs/CHALLENGES.md
docs/DASHBOARDS.md
docs/JOURNAL.md
docs/report/
docs/SSIS_GUIDE.md
docs/RUN_EXPLAINED.md

