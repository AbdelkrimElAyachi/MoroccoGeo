      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"EXEC etl.usp_EndRun @RunID = " + (DT_WSTR, 12) @[User::RunID] + ", @Status = 'Success', @RowsLoaded = 0;"</DTS:PropertyExpression>
