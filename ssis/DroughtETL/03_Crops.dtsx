      DTS:DTSID="{9AF7E600-C95B-4F8B-91C1-2FA68ADC148C}"
      DTS:ExecutableType="Microsoft.ExecuteProcess"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT Run 04_faostat"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="Arguments">"\"" + @[User::ProjectRoot] + "\\scripts\\04_faostat.py\" \"" + @[User::ProjectRoot] + "\""</DTS:PropertyExpression>
