    <DTS:Executable
      DTS:refId="Package\SQL Load Staging FaoCrops"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Empties stg.FaoCrops and BULK INSERTs clean\fao_crops.csv"
      DTS:DTSID="{413DFB15-96A8-43CD-80C8-A4BB9616893A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load Staging FaoCrops"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"SET NOCOUNT ON; TRUNCATE TABLE stg.FaoCrops; BULK INSERT stg.FaoCrops FROM '" + @[User::ProjectRoot] + "\\clean\\fao_crops.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{053D53B0-B7EF-4C5C-A8DD-E7C57D1336D6}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; TRUNCATE TABLE stg.FaoCrops; BULK INSERT stg.FaoCrops FROM 'D:\DroughtProject\clean\fao_crops.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Start Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Calls etl.usp_StartRun and stores the RunID"
      DTS:DTSID="{01109AFB-B5FE-4B95-941C-0868F153F712}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Start Run"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'" + @[System::PackageName] + "', @RunID = @id OUTPUT; SELECT @id AS RunID;"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{922C6A15-1693-446C-A4E6-AD41995C0864}"
          SQLTask:SqlStatementSource="DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'03_Crops', @RunID = @id OUTPUT; SELECT @id AS RunID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RunID"
            SQLTask:DtsVariableName="User::RunID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
