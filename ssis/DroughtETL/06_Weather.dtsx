  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\EPT Run 07_openmeteo"
      DTS:CreationName="Microsoft.ExecuteProcess"
      DTS:Description="Runs scripts\07_openmeteo.py; fails if the script returns a non-zero exit code"
      DTS:DTSID="{04851AF5-305F-4275-B051-4A599F2D0E87}"
      DTS:ExecutableType="Microsoft.ExecuteProcess"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT Run 07_openmeteo"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="Arguments">"\"" + @[User::ProjectRoot] + "\\scripts\\07_openmeteo.py\" \"" + @[User::ProjectRoot] + "\""</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="Executable">@[User::PythonExe]</DTS:PropertyExpression>
      <DTS:PropertyExpression
