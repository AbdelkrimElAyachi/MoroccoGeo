        <SQLTask:SqlTaskData
          SQLTask:Connection="{EDC32E3A-8C01-4E67-8312-AA9DC4CAAA50}"
          SQLTask:SqlStatementSource="EXEC dbo.usp_LoadWeather;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
