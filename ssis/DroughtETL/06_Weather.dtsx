    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load Staging WeatherDaily"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Empties stg.WeatherDaily and BULK INSERTs clean\weather_daily.csv"
      DTS:DTSID="{311ED5C6-7BB0-47A2-A564-43516F419280}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load Staging WeatherDaily"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"SET NOCOUNT ON; TRUNCATE TABLE stg.WeatherDaily; BULK INSERT stg.WeatherDaily FROM '" + @[User::ProjectRoot] + "\\clean\\weather_daily.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{93C7F499-ADB6-4F5C-8F3B-9AB851549471}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; TRUNCATE TABLE stg.WeatherDaily; BULK INSERT stg.WeatherDaily FROM 'D:\DroughtProject\clean\weather_daily.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Start Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Calls etl.usp_StartRun and stores the RunID"
      DTS:DTSID="{95E2052C-9040-4328-811C-B71E5324AE55}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Start Run"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'" + @[System::PackageName] + "', @RunID = @id OUTPUT; SELECT @id AS RunID;"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EDC32E3A-8C01-4E67-8312-AA9DC4CAAA50}"
          SQLTask:SqlStatementSource="DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'06_Weather', @RunID = @id OUTPUT; SELECT @id AS RunID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RunID"
            SQLTask:DtsVariableName="User::RunID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
