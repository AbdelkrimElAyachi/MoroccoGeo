          Arguments="&quot;D:\DroughtProject\scripts\07_openmeteo.py&quot; &quot;D:\DroughtProject&quot;"
          WorkingDirectory="D:\DroughtProject" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
