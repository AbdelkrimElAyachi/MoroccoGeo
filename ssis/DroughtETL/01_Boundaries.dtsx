  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\EPT Download And Check Boundaries"
      DTS:CreationName="Microsoft.ExecuteProcess"
      DTS:Description="Runs scripts\01_boundaries.py; fails if the script returns a non-zero exit code"
      DTS:DTSID="{33B31564-95CD-4C11-BD05-9C7197E53F76}"
      DTS:ExecutableType="Microsoft.ExecuteProcess"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT Download And Check Boundaries"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="Arguments">"\"" + @[User::ProjectRoot] + "\\scripts\\01_boundaries.py\" \"" + @[User::ProjectRoot] + "\""</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="Executable">@[User::PythonExe]</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="WorkingDirectory">@[User::ProjectRoot]</DTS:PropertyExpression>
      <DTS:ObjectData>
        <ExecuteProcessData
          Executable="D:\DroughtProject\venv\Scripts\python.exe"
          Arguments="&quot;D:\DroughtProject\scripts\01_boundaries.py&quot; &quot;D:\DroughtProject&quot;"
          WorkingDirectory="D:\DroughtProject" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL End Run Success"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Calls etl.usp_EndRun with Success and the row count"
      DTS:DTSID="{B50AD174-EA07-4F19-A44D-D88E4E8594DB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL End Run Success"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"EXEC etl.usp_EndRun @RunID = " + (DT_WSTR, 12) @[User::RunID] + ", @Status = 'Success', @RowsLoaded = " + (DT_WSTR, 12) @[User::RowsLoaded] + ";"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{57BCF65F-FDE6-4B46-BD5F-0E1B7162228D}"
          SQLTask:SqlStatementSource="EXEC etl.usp_EndRun @RunID = 0, @Status = 'Success', @RowsLoaded = 0;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load Staging Boundaries"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Empties stg.Boundaries, BULK INSERTs the CSV, returns the row count"
      DTS:DTSID="{5C6E7F3F-FDC5-49F6-878E-504A638F188C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load Staging Boundaries"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"SET NOCOUNT ON; TRUNCATE TABLE stg.Boundaries; BULK INSERT stg.Boundaries FROM '" + @[User::ProjectRoot] + "\\clean\\boundaries_provinces.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001'); SELECT COUNT(*) AS RowsLoaded FROM stg.Boundaries;"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A46EE5C0-8C04-4C24-8867-00F414A1A6E3}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; TRUNCATE TABLE stg.Boundaries; BULK INSERT stg.Boundaries FROM 'D:\DroughtProject\clean\boundaries_provinces.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001'); SELECT COUNT(*) AS RowsLoaded FROM stg.Boundaries;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsLoaded"
            SQLTask:DtsVariableName="User::RowsLoaded" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Start Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Calls etl.usp_StartRun and stores the RunID"
      DTS:DTSID="{2964F778-00F2-4BD6-9B5B-F9A1724512EC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Start Run"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'" + @[System::PackageName] + "', @RunID = @id OUTPUT; SELECT @id AS RunID;"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{57BCF65F-FDE6-4B46-BD5F-0E1B7162228D}"
          SQLTask:SqlStatementSource="DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'01_Boundaries', @RunID = @id OUTPUT; SELECT @id AS RunID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RunID"
            SQLTask:DtsVariableName="User::RunID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
