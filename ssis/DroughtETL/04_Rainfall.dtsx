    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load Staging ChirpsMonthly"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Empties stg.ChirpsMonthly and BULK INSERTs clean\chirps_monthly.csv"
      DTS:DTSID="{A8ADA2C2-50F4-4E31-B085-0E533C5E6E02}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load Staging ChirpsMonthly"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"SET NOCOUNT ON; TRUNCATE TABLE stg.ChirpsMonthly; BULK INSERT stg.ChirpsMonthly FROM '" + @[User::ProjectRoot] + "\\clean\\chirps_monthly.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C202160B-2EAD-4BC6-82DB-44ADEB985318}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; TRUNCATE TABLE stg.ChirpsMonthly; BULK INSERT stg.ChirpsMonthly FROM 'D:\DroughtProject\clean\chirps_monthly.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Start Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Calls etl.usp_StartRun and stores the RunID"
      DTS:DTSID="{2C580031-016A-45FA-B89F-BFBE97D066C7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Start Run"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'" + @[System::PackageName] + "', @RunID = @id OUTPUT; SELECT @id AS RunID;"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{881EC9CA-4F4A-4392-8A57-85F2D6EC2413}"
          SQLTask:SqlStatementSource="DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'04_Rainfall', @RunID = @id OUTPUT; SELECT @id AS RunID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RunID"
            SQLTask:DtsVariableName="User::RunID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
