  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\EPT Run 05_chirps"
      DTS:CreationName="Microsoft.ExecuteProcess"
      DTS:Description="Runs scripts\05_chirps.py; fails if the script returns a non-zero exit code"
      DTS:DTSID="{0D0284D2-52C2-4CFE-B8B3-67E243B0154C}"
      DTS:ExecutableType="Microsoft.ExecuteProcess"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT Run 05_chirps"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="Arguments">"\"" + @[User::ProjectRoot] + "\\scripts\\05_chirps.py\" \"" + @[User::ProjectRoot] + "\""</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="Executable">@[User::PythonExe]</DTS:PropertyExpression>
      <DTS:PropertyExpression
