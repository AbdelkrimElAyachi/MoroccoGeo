    <DTS:Executable
      DTS:refId="Package\SQL Load Staging SpiMonthly"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Empties stg.SpiMonthly and BULK INSERTs clean\spi_monthly.csv"
      DTS:DTSID="{834F5784-A971-45B6-8382-FC7F972630F3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load Staging SpiMonthly"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"SET NOCOUNT ON; TRUNCATE TABLE stg.SpiMonthly; BULK INSERT stg.SpiMonthly FROM '" + @[User::ProjectRoot] + "\\clean\\spi_monthly.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B11DA919-E721-4ED0-BC14-66BC476CA4BF}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; TRUNCATE TABLE stg.SpiMonthly; BULK INSERT stg.SpiMonthly FROM 'D:\DroughtProject\clean\spi_monthly.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Start Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Calls etl.usp_StartRun and stores the RunID"
      DTS:DTSID="{D8E18DBF-93FA-42C5-8475-3B9038669110}"
