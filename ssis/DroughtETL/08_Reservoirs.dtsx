      DTS:ObjectName="SQL Load Staging DamWaterMonthly"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"SET NOCOUNT ON; TRUNCATE TABLE stg.DamWaterMonthly; BULK INSERT stg.DamWaterMonthly FROM '" + @[User::ProjectRoot] + "\\clean\\dam_water_monthly.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);"</DTS:PropertyExpression>
