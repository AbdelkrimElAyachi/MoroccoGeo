  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\EPT Read HCP Census"
      DTS:CreationName="Microsoft.ExecuteProcess"
      DTS:Description="Runs scripts\02_hcp_population.py; fails if a check fails (75 provinces, 12 regions, total 36,828,330)"
      DTS:DTSID="{7CEF6EB2-7E22-4367-9169-C7BD9A02DF50}"
      DTS:ExecutableType="Microsoft.ExecuteProcess"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT Read HCP Census"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="Arguments">"\"" + @[User::ProjectRoot] + "\\scripts\\02_hcp_population.py\" \"" + @[User::ProjectRoot] + "\""</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="Executable">@[User::PythonExe]</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="WorkingDirectory">@[User::ProjectRoot]</DTS:PropertyExpression>
      <DTS:ObjectData>
        <ExecuteProcessData
          Executable="D:\DroughtProject\venv\Scripts\python.exe"
          Arguments="&quot;D:\DroughtProject\scripts\02_hcp_population.py&quot; &quot;D:\DroughtProject&quot;"
          WorkingDirectory="D:\DroughtProject" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL End Run Success"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Calls etl.usp_EndRun with Success and the row count"
      DTS:DTSID="{FC11E00D-AAC2-49B2-A302-6DC0C033C773}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL End Run Success"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"EXEC etl.usp_EndRun @RunID = " + (DT_WSTR, 12) @[User::RunID] + ", @Status = 'Success', @RowsLoaded = " + (DT_WSTR, 12) @[User::RowsLoaded] + ";"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{61C2072A-BF3E-405F-BC3C-8DBD62946430}"
          SQLTask:SqlStatementSource="EXEC etl.usp_EndRun @RunID = 0, @Status = 'Success', @RowsLoaded = 0;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load DimGeography"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Calls dbo.usp_LoadDimGeography and stores the number of provinces loaded"
      DTS:DTSID="{952D0690-B099-4310-8676-F560D112C4A1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load DimGeography"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{61C2072A-BF3E-405F-BC3C-8DBD62946430}"
          SQLTask:SqlStatementSource="EXEC dbo.usp_LoadDimGeography;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsLoaded"
            SQLTask:DtsVariableName="User::RowsLoaded" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load Staging HCP"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Empties stg.HcpPopulation and BULK INSERTs the CSV"
      DTS:DTSID="{2DA573FB-A48C-4834-9DEC-7FCC75B688D4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load Staging HCP"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"SET NOCOUNT ON; TRUNCATE TABLE stg.HcpPopulation; BULK INSERT stg.HcpPopulation FROM '" + @[User::ProjectRoot] + "\\clean\\hcp_population_2024.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001'); SELECT COUNT(*) AS RowsLoaded FROM stg.HcpPopulation;"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1FFDE9F5-6009-474B-BEAA-9D7B410464AA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; TRUNCATE TABLE stg.HcpPopulation; BULK INSERT stg.HcpPopulation FROM 'D:\DroughtProject\clean\hcp_population_2024.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001'); SELECT COUNT(*) AS RowsLoaded FROM stg.HcpPopulation;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsLoaded"
            SQLTask:DtsVariableName="User::RowsLoaded" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Start Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Calls etl.usp_StartRun and stores the RunID"
      DTS:DTSID="{FBD55A4D-45B2-4317-942B-9D5FF0192E65}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Start Run"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'" + @[System::PackageName] + "', @RunID = @id OUTPUT; SELECT @id AS RunID;"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{61C2072A-BF3E-405F-BC3C-8DBD62946430}"
          SQLTask:SqlStatementSource="DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'02_Geography', @RunID = @id OUTPUT; SELECT @id AS RunID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RunID"
            SQLTask:DtsVariableName="User::RunID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
