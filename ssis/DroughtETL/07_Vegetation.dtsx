      DTS:DTSID="{06E26DB4-7EE7-40C9-880C-649F44F71647}"
      DTS:ExecutableType="Microsoft.ExecuteProcess"
      DTS:LocaleID="-1"
      DTS:ObjectName="EPT Run 08_ndvi"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="Arguments">"\"" + @[User::ProjectRoot] + "\\scripts\\08_ndvi.py\" \"" + @[User::ProjectRoot] + "\""</DTS:PropertyExpression>
