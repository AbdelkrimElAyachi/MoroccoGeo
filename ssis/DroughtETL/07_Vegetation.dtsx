    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load Staging NdviMonthly"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Empties stg.NdviMonthly and BULK INSERTs clean\ndvi_monthly.csv"
      DTS:DTSID="{70056659-745C-4CCA-A863-70E49240ACC6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load Staging NdviMonthly"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"SET NOCOUNT ON; TRUNCATE TABLE stg.NdviMonthly; BULK INSERT stg.NdviMonthly FROM '" + @[User::ProjectRoot] + "\\clean\\ndvi_monthly.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E6D4CD4B-6618-4F44-AD6F-77042CDBA6BC}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; TRUNCATE TABLE stg.NdviMonthly; BULK INSERT stg.NdviMonthly FROM 'D:\DroughtProject\clean\ndvi_monthly.csv' WITH (FIRSTROW = 2, FIELDTERMINATOR = ';', ROWTERMINATOR = '0x0a', CODEPAGE = '65001', TABLOCK);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Start Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Calls etl.usp_StartRun and stores the RunID"
      DTS:DTSID="{C029BB1F-A0DB-4FB8-98C6-970709FE4289}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Start Run"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'" + @[System::PackageName] + "', @RunID = @id OUTPUT; SELECT @id AS RunID;"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F67E266B-B798-46BD-BB47-B43459B571D2}"
          SQLTask:SqlStatementSource="DECLARE @id INT; EXEC etl.usp_StartRun @PackageName = N'07_Vegetation', @RunID = @id OUTPUT; SELECT @id AS RunID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RunID"
            SQLTask:DtsVariableName="User::RunID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
